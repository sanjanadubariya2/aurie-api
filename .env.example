# --- Core ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# --- Database -------------------------------------------------------------
MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/aurie?retryWrites=true&w=majority

# --- Auth -------------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string

# --- Email (pick one: resend | smtp) --------------------------------------
EMAIL_PROVIDER=resend
EMAIL_FROM="Aurie <orders@shopaurie.co>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Log verbosity: trace | debug | info | warn | error (default info)
LOG_LEVEL=info

# --- AI (Google Gemini) — leave blank and AI features stay hidden ----------
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_VISION_MODEL=

# --- Shiprocket (manual shipping while blank) ------------------------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PINCODE=400001

# --- Phone OTP (not used by checkout today; leave blank) --
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=AURIE
FAST2SMS_API_KEY=
# From Fast2SMS -> Smart OTP -> the OTP ID shown after assigning an approved
# WhatsApp template to a number
FAST2SMS_OTP_ID=

# WhatsApp Cloud API (Meta) — free tier, no DLT wait. Get these from
# developers.facebook.com: create an app -> add WhatsApp product -> the
# setup page shows a temporary access token + phone_number_id. TEMPLATE_NAME
# must match an approved "Authentication" category template in that app.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=otp_verification
WHATSAPP_TEMPLATE_LANG=en_US

# --- Razorpay ---------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Cloudinary (admin product image uploads) ------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=aurie/products

# --- Contact (mirrors the frontend .env) ------------------------------
WHATSAPP=0000000000


