# --- Core ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# --- Database -------------------------------------------------------------
MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/aurie?retryWrites=true&w=majority

# --- Auth -------------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string

# --- Email (pick one: resend | smtp) --------------------------------------
EMAIL_PROVIDER=resend
EMAIL_FROM="Aurie <orders@shopaurie.co>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- SMS (pick one: msg91 | fast2sms) — leave blank to log codes locally --
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=AURIE
FAST2SMS_API_KEY=

# --- Razorpay ---------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Cloudinary (admin product image uploads) ------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=aurie/products

# --- Contact (mirrors the frontend .env) ------------------------------
WHATSAPP=0000000000


